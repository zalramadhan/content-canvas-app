# Salin file ini menjadi `.env` dan isi dengan nilai dari Supabase Dashboard:
# Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Catatan: untuk GitHub Pages via GitHub Actions, set dua variabel ini
# sebagai repository secrets dengan nama yang sama (tanpa prefix yang berbeda).
